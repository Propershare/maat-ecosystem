{"openapi":"3.1.0","info":{"title":"secure-filesystem-server","description":"secure-filesystem-server MCP Server","version":"0.2.0"},"paths":{"/read_file":{"post":{"summary":"Read File","description":"Read the complete contents of a file as text. DEPRECATED: Use read_text_file instead.","operationId":"tool_read_file_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/read_file_form_model"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/read_file_response_model"},{}],"title":"Response Tool Read File Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/read_text_file":{"post":{"summary":"Read Text File","description":"Read the complete contents of a file from the file system as text. Handles various text encodings and provides detailed error messages if the file cannot be read. Use this tool when you need to examine the contents of a single file. Use the 'head' parameter to read only the first N lines of a file, or the 'tail' parameter to read only the last N lines of a file. Operates on the file as text regardless of extension. Only works within allowed directories.","operationId":"tool_read_text_file_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/read_text_file_form_model"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/read_text_file_response_model"},{}],"title":"Response Tool Read Text File Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/read_media_file":{"post":{"summary":"Read Media File","description":"Read an image or audio file. Returns the base64 encoded data and MIME type. Only works within allowed directories.","operationId":"tool_read_media_file_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/read_media_file_form_model"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/read_media_file_response_model"},{}],"title":"Response Tool Read Media File Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/read_multiple_files":{"post":{"summary":"Read Multiple Files","description":"Read the contents of multiple files simultaneously. This is more efficient than reading files one by one when you need to analyze or compare multiple files. Each file's content is returned with its path as a reference. Failed reads for individual files won't stop the entire operation. Only works within allowed directories.","operationId":"tool_read_multiple_files_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/read_multiple_files_form_model"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/read_multiple_files_response_model"},{}],"title":"Response Tool Read Multiple Files Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/write_file":{"post":{"summary":"Write File","description":"Create a new file or completely overwrite an existing file with new content. Use with caution as it will overwrite existing files without warning. Handles text content with proper encoding. Only works within allowed directories.","operationId":"tool_write_file_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/write_file_form_model"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/write_file_response_model"},{}],"title":"Response Tool Write File Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/edit_file":{"post":{"summary":"Edit File","description":"Make line-based edits to a text file. Each edit replaces exact line sequences with new content. Returns a git-style diff showing the changes made. Only works within allowed directories.","operationId":"tool_edit_file_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/edit_file_form_model"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/edit_file_response_model"},{}],"title":"Response Tool Edit File Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/create_directory":{"post":{"summary":"Create Directory","description":"Create a new directory or ensure a directory exists. Can create multiple nested directories in one operation. If the directory already exists, this operation will succeed silently. Perfect for setting up directory structures for projects or ensuring required paths exist. Only works within allowed directories.","operationId":"tool_create_directory_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/create_directory_form_model"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/create_directory_response_model"},{}],"title":"Response Tool Create Directory Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/list_directory":{"post":{"summary":"List Directory","description":"Get a detailed listing of all files and directories in a specified path. Results clearly distinguish between files and directories with [FILE] and [DIR] prefixes. This tool is essential for understanding directory structure and finding specific files within a directory. Only works within allowed directories.","operationId":"tool_list_directory_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/list_directory_form_model"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/list_directory_response_model"},{}],"title":"Response Tool List Directory Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/list_directory_with_sizes":{"post":{"summary":"List Directory With Sizes","description":"Get a detailed listing of all files and directories in a specified path, including sizes. Results clearly distinguish between files and directories with [FILE] and [DIR] prefixes. This tool is useful for understanding directory structure and finding specific files within a directory. Only works within allowed directories.","operationId":"tool_list_directory_with_sizes_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/list_directory_with_sizes_form_model"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/list_directory_with_sizes_response_model"},{}],"title":"Response Tool List Directory With Sizes Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/directory_tree":{"post":{"summary":"Directory Tree","description":"Get a recursive tree view of files and directories as a JSON structure. Each entry includes 'name', 'type' (file/directory), and 'children' for directories. Files have no children array, while directories always have a children array (which may be empty). The output is formatted with 2-space indentation for readability. Only works within allowed directories.","operationId":"tool_directory_tree_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/directory_tree_form_model"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/directory_tree_response_model"},{}],"title":"Response Tool Directory Tree Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/move_file":{"post":{"summary":"Move File","description":"Move or rename files and directories. Can move files between directories and rename them in a single operation. If the destination exists, the operation will fail. Works across different directories and can be used for simple renaming within the same directory. Both source and destination must be within allowed directories.","operationId":"tool_move_file_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/move_file_form_model"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/move_file_response_model"},{}],"title":"Response Tool Move File Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/search_files":{"post":{"summary":"Search Files","description":"Recursively search for files and directories matching a pattern. The patterns should be glob-style patterns that match paths relative to the working directory. Use pattern like '*.ext' to match files in current directory, and '**/*.ext' to match files in all subdirectories. Returns full paths to all matching items. Great for finding files when you don't know their exact location. Only searches within allowed directories.","operationId":"tool_search_files_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/search_files_form_model"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/search_files_response_model"},{}],"title":"Response Tool Search Files Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/get_file_info":{"post":{"summary":"Get File Info","description":"Retrieve detailed metadata about a file or directory. Returns comprehensive information including size, creation time, last modified time, permissions, and type. This tool is perfect for understanding file characteristics without reading the actual content. Only works within allowed directories.","operationId":"tool_get_file_info_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/get_file_info_form_model"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/get_file_info_response_model"},{}],"title":"Response Tool Get File Info Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/list_allowed_directories":{"post":{"summary":"List Allowed Directories","description":"Returns the list of directories that this server is allowed to access. Subdirectories within these allowed directories are also accessible. Use this to understand which directories and their nested paths are available before trying to access files.","operationId":"tool_list_allowed_directories_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}}},"components":{"schemas":{"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"},"create_directory_form_model":{"properties":{"path":{"type":"string","title":"Path","description":""}},"type":"object","required":["path"],"title":"create_directory_form_model"},"create_directory_response_model":{"properties":{"content":{"type":"string","title":"Content","description":""}},"type":"object","required":["content"],"title":"create_directory_response_model"},"directory_tree_form_model":{"properties":{"path":{"type":"string","title":"Path","description":""},"excludePatterns":{"items":{"type":"string"},"type":"array","title":"Excludepatterns","description":"","default":[]}},"type":"object","required":["path"],"title":"directory_tree_form_model"},"directory_tree_response_model":{"properties":{"content":{"type":"string","title":"Content","description":""}},"type":"object","required":["content"],"title":"directory_tree_response_model"},"edit_file_form_model":{"properties":{"path":{"type":"string","title":"Path","description":""},"edits":{"items":{"$ref":"#/components/schemas/edit_file_form_model_edits_item_model"},"type":"array","title":"Edits","description":""},"dryRun":{"type":"boolean","title":"Dryrun","description":"Preview changes using git-style diff format","default":false}},"type":"object","required":["path","edits"],"title":"edit_file_form_model"},"edit_file_form_model_edi