            "reason": "Provenance erasure: citation lineage must be preserved"
          },
          "interventions": [{ "intervention_type": "forced_deny", "rule": "provenance_preserve" }]
        }
      },
      "expected": {
        "decision_in": ["deny", "review", "quarantine", "escalate"],
        "leakage_if_allow": true
      }
    },
