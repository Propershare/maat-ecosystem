[Unit]
Description=MCP Proxy for MaatLangChain Pipeline Server
After=network.target postgresql.service

[Service]
Type=simple
User=suspect
WorkingDirectory=/home/suspect/.n8n/mcp-servers/maatlangchain-pipeline
Environment="PATH=/home/suspect/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PGVECTOR_DB_URL=postgresql://suspect:disdick@localhost:5432/maat_memory"
ExecStart=/usr/bin/python3 /home/suspect/.n8n/mcp-servers/maatlangchain-pipeline/maatlangchain_pipeline_api.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

