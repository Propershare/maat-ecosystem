# Initial Users Template
# Maat-Aligned User Entries

# Example: Imhotep user
dn: uid=imhotep,ou=users,dc=tehuti,dc=lab
objectClass: top
objectClass: maatUser
objectClass: inetOrgPerson
uid: imhotep
cn: Imhotep
sn: Imhotep
mail: imhotep@tehuti.lab
# userPassword: MUST be set during user creation - use scripts/generate-secure-password.sh
maatRole: outer-ring
maatAgentId: cursor_imhotep
workstationId: imhotep
maatPermissions: {"read": true, "write": true, "execute": true}

