# Tehuti Lab Maat-Aligned LDAP Schema
# Custom schema for three-ring governance and agent coordination

# Maat User Object Class
attributetype ( 1.3.6.1.4.1.99999.1.1.1
    NAME 'maatRole'
    DESC 'Maat role: inner-ring, middle-ring, or outer-ring'
    EQUALITY caseIgnoreMatch
    SUBSTR caseIgnoreSubstringsMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
    SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.99999.1.1.2
    NAME 'maatAgentId'
    DESC 'Agent identifier for gitMaat coordination'
    EQUALITY caseIgnoreMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
    SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.99999.1.1.3
    NAME 'workstationId'
    DESC 'Associated workstation identifier'
    EQUALITY caseIgnoreMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
    SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.99999.1.1.4
    NAME 'maatPermissions'
    DESC 'JSON permissions object'
    EQUALITY caseIgnoreMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
    SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.99999.1.1.5
    NAME 'lastMaatActivity'
    DESC 'Last activity timestamp'
    EQUALITY generalizedTimeMatch
    ORDERING generalizedTimeOrderingMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.24
    SINGLE-VALUE )

# Maat User Object Class
objectclass ( 1.3.6.1.4.1.99999.2.1.1
    NAME 'maatUser'
    DESC 'Maat-aligned user object class'
    SUP inetOrgPerson
    STRUCTURAL
    MUST ( uid $ cn $ mail )
    MAY ( maatRole $ maatAgentId $ workstationId $ maatPermissions $ lastMaatActivity ) )

# Maat Group Object Class
objectclass ( 1.3.6.1.4.1.99999.2.1.2
    NAME 'maatGroup'
    DESC 'Maat-aligned group object class'
    SUP groupOfNames
    STRUCTURAL
    MUST ( cn $ member )
    MAY ( description $ maatRole ) )

# Maat Workstation Object Class
objectclass ( 1.3.6.1.4.1.99999.2.1.3
    NAME 'maatWorkstation'
    DESC 'Maat workstation object class'
    SUP device
    STRUCTURAL
    MUST ( cn $ ipHostNumber )
    MAY ( description $ maatAgentId ) )

