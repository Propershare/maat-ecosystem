# Access Control List (ACL) Configuration
# Maat-Aligned Access Controls

# Password access
dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword
  by self write
  by anonymous auth
  by dn="cn=admin,dc=tehuti,dc=lab" write
  by * none
-
olcAccess: {1}to *
  by self write
  by dn="cn=admin,dc=tehuti,dc=lab" write
  by users read
  by * none

