# Password Policy Configuration
# Maat-Aligned Password Policies
# Note: Requires pwdPolicy schema (usually in /etc/ldap/schema/ppolicy.schema)

dn: ou=policies,dc=tehuti,dc=lab
objectClass: top
objectClass: organizationalUnit
ou: policies
description: Password policies

dn: cn=passwordPolicy,ou=policies,dc=tehuti,dc=lab
objectClass: top
objectClass: device
objectClass: pwdPolicy
cn: passwordPolicy
pwdAttribute: userPassword
pwdMinAge: 0
pwdMaxAge: 0
pwdInHistory: 5
pwdCheckQuality: 2
pwdMinLength: 12
pwdExpireWarning: 604800
pwdGraceAuthNLimit: 0
pwdLockout: TRUE
pwdLockoutDuration: 1800
pwdMaxFailure: 5
pwdFailureCountInterval: 600
pwdMustChange: FALSE
pwdAllowUserChange: TRUE
pwdSafeModify: FALSE

